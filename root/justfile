# Workspace-root justfile. The root is not a repo; this file is reached through
# a symlink (created by `just bootstrap`), so the fleet recipes work here without
# `cd kleinbem`. common.just sees kleinbem/repos.nix below and sets ROOT to here.
import 'kleinbem/.just/common.just'

# --- Modules ---

# Fleet jj recipes: ws-new/ws-list/ws-gc, push-all, ...
mod jj 'kleinbem/.just/jj.just'

[group("Main")]
default:
    @just jj::hub

