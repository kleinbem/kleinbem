#!/usr/bin/env bash
export NIXPKGS_ALLOW_UNFREE=1
# Shared workspace devshell; most sibling repos inherit it through their own
# .envrc (`source_env_if_exists ../.envrc`). direnv runs this symlinked file from
# the root's directory, so ./nix-devshells resolves against the root.
use flake ./nix-devshells#workspace
