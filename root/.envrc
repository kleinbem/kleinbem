#!/usr/bin/env bash
export NIXPKGS_ALLOW_UNFREE=1
# Shared workspace devshell — inherited by every flat sibling repo via their
# own `.envrc`'s `source_env_if_exists ../.envrc` (nix-config, nix-presets,
# nix-hardware, nix-packages, nix-devshells itself, ...). Same devshell the
# `nix/` conductor loads directly. Missing since the justfile/repo flattening
# refactor — that's why `colmena` (and other devshell tools) disappeared from
# sibling repos' PATH.
#
# The root's .envrc is a symlink to kleinbem/root/.envrc; direnv runs it from
# the symlink's directory, so ./nix-devshells resolves against the root.
use flake ./nix-devshells#workspace
